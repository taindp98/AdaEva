# ==============================================================================
# AdaEva environment configuration
#
#   cp .env.example .env
#
# Every runner calls `load_dotenv(<repo>/.env)` at start-up. Only the variables
# listed here are read by `src/` (see `src/utils/llm.py`). Leave a key empty
# for any provider you do not use.
#
# NOTE: the model is normally chosen on the command line with `--llm-model`;
# the *_MODEL variables below are only fallbacks when no model is passed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenAI-compatible API  (--llm-backend openrouter, the default)
# ------------------------------------------------------------------------------
# Key for the OpenAI chat-completions endpoint. OPENROUTER_API_KEY is accepted
# as a fallback name for the same key.
OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Endpoint (default: https://api.openai.com/v1). Point it at any
# OpenAI-compatible service, e.g. https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Fallback model id (OPENROUTER_MODEL is accepted as an alias)
OPENAI_MODEL=gpt-4.1-nano-2025-04-14
# OPENROUTER_MODEL=
# Retries on HTTP 429 / transient errors (default: 6)
OPENAI_MAX_RETRIES=6

# ------------------------------------------------------------------------------
# 2. Google Gemini via its OpenAI-compatible endpoint  (--llm-backend google)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_MODEL=gemini-3.1-flash-lite
# Thinking-token budget: 0 = off (default), N > 0 = cap, -1 = dynamic
GOOGLE_THINKING_BUDGET=0

# ------------------------------------------------------------------------------
# 3. Mistral AI  (--llm-backend mistral)
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# Minimum seconds between request starts, shared across threads (default: 1.25)
MISTRAL_MIN_INTERVAL=1.25

# ------------------------------------------------------------------------------
# 4. Self-hosted vLLM OpenAI-compatible server  (--llm-backend vllm)
# ------------------------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=mistralai/Devstral-Small-2-24B-Instruct-2512
VLLM_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 5. Local Ollama server  (--llm-backend ollama; --ollama-host overrides the host)
# ------------------------------------------------------------------------------
OLLAMA_HOST=localhost:11434
OLLAMA_MODEL=codellama
OLLAMA_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 6. Weights & Biases (optional; only used with --use-wandb)
#    Read directly by the `wandb` library. A W&B failure never aborts a run.
# ------------------------------------------------------------------------------
# WANDB_API_KEY=
# WANDB_MODE=offline

# ------------------------------------------------------------------------------
# 7. Runtime / debugging
# ------------------------------------------------------------------------------
# Pure-Python protobuf avoids version clashes between wandb and other deps
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
# Set to 1 to print per-worker evaluation traces (EoH SH runners / LLaMEA runners)
# EOH_WORKER_TRACE=1
# LLAMEA_WORKER_TRACE=1
