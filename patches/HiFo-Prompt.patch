diff --git a/hifo/src/hifo/methods/hifo/hifo_hp.py b/hifo/src/hifo/methods/hifo/hifo_hp.py
new file mode 100644
index 0000000..679e4da
--- /dev/null
+++ b/hifo/src/hifo/methods/hifo/hifo_hp.py
@@ -0,0 +1,50 @@
+"""Tunable HiFo-Prompt hyperparameters (the paper's default configuration).
+
+These were previously hard-coded literals scattered across ``insight_pool.py``,
+``evolutionary_navigator.py`` and ``hifo_interface_EC.py``. They are collected
+here as module-level attributes so a driver (e.g. ``src/reprod/hifo_obp.py``) can
+override them at runtime BEFORE the engine builds its InsightPool / Navigator:
+
+    import hifo.methods.hifo.hifo_hp as hifo_hp
+    hifo_hp.POOL_CAPACITY = 30
+
+The call sites read ``hifo_hp.<NAME>`` at call time (not ``from hifo_hp import
+<NAME>``), so an override takes effect for every subsequent read. Every default
+below equals the value stated in Chen et al. (2026), HiFo-Prompt, so importing
+this module changes nothing on its own.
+"""
+
+# --- Hindsight: Insight Pool -------------------------------------------------
+POOL_CAPACITY = 30            # C_pool   — max insights retained
+NOVELTY_THRESHOLD = 0.7       # theta_novelty — Jaccard admission cutoff
+SELECTION_COUNT = 3           # s        — top-s insights injected per generation
+USAGE_PENALTY_WEIGHT = 0.1    # w_u      — coeff of -w_u*log(uses+1)
+RECENCY_BONUS = 0.2           # tau_r    — bonus for recently-used insights
+RECENCY_WINDOW = 2            # T_w      — generations the recency bonus spans
+EMA_ALPHA = 0.3               # alpha    — EMA rate for effectiveness updates
+DECAY_RATE = 0.01             # R_decay  — eviction-score time decay
+PROBATION_USAGE_COUNT = 3     # T_usage  — uses below which an insight is immune
+
+# --- Credit assignment tiers (Eq. 3 intercepts) ------------------------------
+CREDIT_BEST = 0.8             # beta_best — offspring beats population best
+CREDIT_INC = 0.2             # beta_inc  — offspring beats population average
+CREDIT_PEN = -0.3            # beta_pen  — offspring below average (penalty)
+
+# --- Timeouts: decouple the eval cap from the whole-offspring budget ---------
+# The stock package used ONE value (paras eva_timeout) for BOTH the inner eval
+# cap (future.result timeout) AND the outer per-offspring joblib budget
+# (eva_timeout+15) that must also cover the LLM generation. That coupling meant
+# enlarging the budget to fit the LLM also enlarged the eval cap, letting a slow
+# candidate eval blow the whole batch. These two override that split when set:
+#   EVAL_TIMEOUT -> caps ONLY the candidate evaluation (kills a slow/looping one)
+#   TASK_BUDGET  -> the whole get_offspring task = LLM generation + eval + margin
+# Left as None (the default), the package falls back to its original single-knob
+# behavior (self.timeout and self.timeout+15), so other callers are unaffected.
+EVAL_TIMEOUT = None    # seconds; None -> use paras eva_timeout
+TASK_BUDGET = None     # seconds; None -> use paras eva_timeout + 15
+
+# --- Foresight: Evolutionary Navigator ---------------------------------------
+PROGRESS_EPS = 1e-4           # delta g   — min best-fitness gain counted as progress
+STAGNATION_THRESHOLD = 3      # tau_stag  — stagnant gens before forcing Explore
+PROGRESS_THRESHOLD = 2        # tau_prog  — progress gens before forcing Exploit
+DIVERSITY_THRESHOLD = 0.3     # delta_p   — phenotypic-diversity floor for Explore
